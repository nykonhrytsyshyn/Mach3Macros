' --------------------------------------------- '
' Macro Name: Auto Tool Zero                    '
' Developer: Nykon Hrytsyshyn                   '
' Date of release: 2025-05-22                   '
' --------------------------------------------- '

Option Explicit
Option Base 1

' --------------------------------------------- '
'       Settings for Auto Tool Zero macro       '
' --------------------------------------------- '

Const MacroUnits As Integer = 0        ' Units of the macro (0 = millimeters, 1 = inches)
Const ProbeFeed As Double = 200.0      ' Feedrate to use for probing (units/min)
Const FinishProbeFeed As Double = 10.0 ' Feedrate to use for finish probing (units/min)

Const PlateOffset As Double = 0.0      ' Offset for the touch plate (units)
Const SafeMargin As Double = 1.0       ' Safe margin to return the tool from certain position (units)
Const ZUpperBound As Double = 0.0      ' Upper Z-axis boundary in machine coordinates (units)
Const ZLowerBound As Double = -60.0    ' Lower Z-axis boundary in machine coordinates (units)
   
Const DebugMode As Boolean = False     ' Set to True to enable debug messages

' ---------------------------------------------------------------------------------- '
'   __          __     _____  _   _ _____ _   _  _____   __________  _   _ ______    '
'   \ \        / /\   |  __ \| \ | |_   _| \ | |/ ____| |___  / __ \| \ | |  ____|   '
'    \ \  /\  / /  \  | |__) |  \| | | | |  \| | |  __     / / |  | |  \| | |__      '
'     \ \/  \/ / /\ \ |  _  /| . ` | | | | . ` | | |_ |   / /| |  | | . ` |  __|     '
'      \  /\  / ____ \| | \ \| |\  |_| |_| |\  | |__| |  / /_| |__| | |\  | |____    '
'       \/  \/_/    \_\_|  \_\_| \_|_____|_| \_|\_____| /_____\____/|_| \_|______|   '
'                                                                                    '
' ---------------------------------------------------------------------------------- '
' Next constants are Mach3-specific and are used for the macro. The macro is         '
' designed to work only with Mach3 and uses its API to control the machine.          '
' Unfortunately, the documentation of the current functions did not stay current, so '
' the macro may not work with the certain versions of Mach3. The manual was mostly   '
' written by volunteers, so it is recommended to familiarise yourself with the       '
' macro and test it before using it.                                                 '
'                                                                                    '
' See Mach3 "Macro Programming Reference Manual" for more information:               '
' https://machsupport.com/wp-content/uploads/2013/02/Mach3_V3.x_Macro_Prog_Ref.pdf   '
' ---------------------------------------------------------------------------------- '

Const ProbeSignal As Integer = 22        ' Input number for probe signal
        
Const ProbeLED As Integer = 825          ' LED number for probe (Diditize Input)
Const CoordAbsLED As Integer = 48        ' LED number for absolute coordinates
Const CoordIncLED As Integer = 49        ' LED number for incremental coordinates

Const MoveModeDRO As Integer = 819       ' DRO number for move mode (0 = G00, 1 = G01)
Const FixtureOffsetZDRO As Integer = 832 ' DRO number for Z-axis multi-function DRO

Const ProbeOffsetXVar As Integer = 2000  ' Variable number for probe offset by X-axis
Const ProbeOffsetYVar As Integer = 2001  ' Variable number for probe offset by Y-axis
Const ProbeOffsetZVar As Integer = 2002  ' Variable number for probe offset by Z-axis

' Machine message types
'
' Integer value indicating which buttons will be displayed
' in the message box
Const MachMsgTypeOK As Integer = 0                     ' OK button
Const MachMsgTypeOKCancel As Integer = 1 			   ' OK and Cancel buttons
Const MachMsgTypeAbortRetryIgnore As Integer = 2 	   ' Abort, Retry and Ignore buttons
Const MachMsgTypeYesNoCancel As Integer = 3 		   ' Yes, No and Cancel buttons
Const MachMsgTypeYesNo As Integer = 4 				   ' Yes and No buttons
Const MachMsgTypeRetryCancel As Integer = 5 		   ' Retry and Cancel buttons
Const MachMsgTypeCancelTryAgainContinue As Integer = 6 ' Cancel, Try Again and Continue buttons

' Machine message buttons
'
' Integer value indicating which button the user clicked
Const MachMsgReturnOK As Integer = 1        ' OK button
Const MachMsgReturnCancel As Integer = 2    ' Cancel button
Const MachMsgReturnAbort As Integer = 3     ' Abort button
Const MachMsgReturnRetry As Integer = 4     ' Retry button
Const MachMsgReturnIgnore As Integer = 5    ' Ignore button
Const MachMsgReturnYes As Integer = 6       ' Yes button
Const MachMsgReturnNo As Integer = 7        ' No button
Const MachMsgReturnTryAgain As Integer = 10 ' Try Again button
Const MachMsgReturnContinue As Integer = 11 ' Continue button

' Tool parameters
'
' Integer value indicating a specific tool parameter
Const ToolDiameterParam As Integer = 1 ' Tool diameter
Const ToolZoffsetParam As Integer = 2  ' Tool Z-axis offset
Const ToolXwearParam As Integer = 3    ' Tool X-axis wear
Const ToolZwearParam As Integer = 4    ' Tool Z-axis wear

' Move Modes
'
' Integer value indicating the move mode
Const MoveModeRapid As Integer = 0  ' Rapid move (G00)
Const MoveModeLinear As Integer = 1 ' Linear move (G01)

' Units of measurement
'
' Integer value indicating the units of measurement
Const UnitsMM As Integer = 0 ' Millimeters (G21)
Const UnitsIn As Integer = 1 ' Inches (G20)

' Coordinate Modes
'
' Integer value indicating the coordinate mode
Const CoordModeAbsolute As Integer = 0    ' Absolute coordinates (G90)
Const CoordModeIncremental As Integer = 1 ' Incremental coordinates (G91)

' Axis identifiers
'
' Each axis is represented by an integer value, which is used
' to identify the axis in the Mach3 API.
Const XAxis As Integer = 0
Const YAxis As Integer = 1
Const ZAxis As Integer = 2
Const AAxis As Integer = 3
Const BAxis As Integer = 4
Const CAxis As Integer = 5

' --------------------------------------------- '
' Custom macro-specific constants and variables '
' --------------------------------------------- '
' These constants and variables are only        '
' used in this macro and are not part of the    ' 
' Mach3 API.                                    '
' --------------------------------------------- '

' Simple implementation of the carriage return and line feed
' character sequence (CRLF) for message boxes
Dim CrLf As String
CrLf = Chr$(13) & Chr$(10)

' Message types
'
' Used for macro-specific message functions
Const MsgTypeStatus As Integer = 0 ' Displays a message in the status bar of Mach3
Const MsgTypeDialog As Integer = 1 ' Displays a message in a dialog box

' Macro modes
Const ZeroCoordMode As Integer = 1 ' Setting Z-axis to zero by probing
Const ToolCompMode As Integer = 2  ' Setting tool length compensation by probing

' --------------------------------------------- '
'         Cached variables for the macro        '
' --------------------------------------------- '
' These variables are used to store the values  '
' of the frequently used variables in the macro.'
' This is done to avoid calling the Mach3 API   '
' functions multiple times, which can slow down '
' the macro execution.                          '
' --------------------------------------------- '

' MacroUnitsStr is used to display the units of measurement
' in the string format (inches/mm)
Dim MacroUnitsStr As String
MacroUnitsStr = TernaryIf(MacroUnits = UnitsIn, "in", "mm")

' --------------------------------------------- '
'    Saved current parameters of the machine    '
' --------------------------------------------- '
' These variables are used to save the current  '
' parameters of the machine before running the  '
' macro.                                        '
' If the macro is canceled in the right way,    '
' the original values will be restored.         '
' --------------------------------------------- '

Dim CurrentMoveMode, CurrentUnits, CurrentFixture, CurrentCoordMode As Integer
Dim CurrentFeed, CurrentX, CurrentY, CurrentZ As Double

CurrentMoveMode = GetMoveMode()    ' Save current move mode (G00/G01)
CurrentUnits = GetUnits()		   ' Save current units (inches/mm) (G20/G21)
CurrentCoordMode = GetCoordMode()  ' Save current coordinate mode (G90/G91)
CurrentFeed = FeedRate()           ' Save current feedrate (units/min)
CurrentX = GetABSPosition(XAxis)   ' Save current X-axis machine position
CurrentY = GetABSPosition(YAxis)   ' Save current Y-axis machine position
CurrentZ = GetABSPosition(ZAxis)   ' Save current Z-axis machine position

' ------------------------------------------------------------------ '

Call Main() ' Calls the main subroutine, all logic is executed here

' ------------------------------------------------------------------ '

' Main subroutine.
'
' This is where the main logic of the macro is executed.
Sub Main()
	' Check if the "E-Stop" is active
	' If it is, exit the macro and display an error message
	If (IsEStop()) Then
		Call ExitWithError(MsgTypeDialog, "E-Stop is active!" & CrLf & _
			"Please reset the E-Stop before running the macro.")
	End If

	' Debug saved parameters
	Call Debug(MsgTypeDialog, "Current Savings:" & CrLf & _
		"- Move Mode: " & CurrentMoveMode & " (" & TernaryIf(CurrentMoveMode = MoveModeRapid, "G00 - Rapid)", "G01 - Linear)") & CrLf & _
		"- Units: " & CurrentUnits & " (" & TernaryIf(CurrentUnits = UnitsIn, "G20 - Inches)", "G21 - Millimeters)") & CrLf & _
		"- Coordinate Mode: " & CurrentCoordMode & " (" & TernaryIf(CurrentCoordMode = CoordModeAbsolute, "G90 - Absolute)", "G91 - Incremental)") & CrLf & _
		"- Feedrate: " & CurrentFeed & TernaryIf(CurrentUnits = UnitsIn, "in/min", "mm/min") & CrLf & _
		"- Position in Machine Coordinates:" & CrLf & _
		"  - X: " & CurrentX & MacroUnitsStr & CrLf & _
		"  - Y: " & CurrentY & MacroUnitsStr & CrLf & _
		"  - Z: " & CurrentZ & MacroUnitsStr)

	' Check for probe wiring
	If (IsSuchSignal(ProbeSignal) = 0) Then 
		Call ExitWithError(MsgTypeDialog, "No Touch probe wired")
	End If 

	' Check for probe grounding
	If (IsProbeWired()) Then
		Call ExitWithError(MsgTypeDialog, "Touch Plate is already grounded")
	End If

	' Ask user for the mode of the operation
	Dim MacroMode As Integer
	MacroMode = SuggestModes()

	' Debug selected mode
	Call Debug(MsgTypeStatus, "Selected mode: " & MacroMode & " (" & _
		TernaryIf(MacroMode = ZeroCoordMode, "Zero Tool", "Set Tool Length Compensation") & ")")

	Call RunMacroMode(MacroMode) ' Run the selected mode
	Call ExitMacro()             ' Exit the macro and restore original values
End Sub

' --------------------------------------------- '
'               Macro modes logic               '
' --------------------------------------------- '

' This function is called to suggest the user the
' available modes of interaction with the macro.
Function SuggestModes() As Integer
	' Tell the user about available modes
	Call CancellableMsg("After pressing OK, you will be prompted to select the mode of operation." & CrLf & CrLf & _
		"Available modes:" & CrLf & _
		ZeroCoordMode & ". Set Z-axis to zero by probing the touch plate." & CrLf & _
		ToolCompMode & ". Set tool length compensation by probing the touch plate.", _
		"Auto Tool Zero")

	' Ask user for the mode of the operation and return it
	SuggestModes = CInt(Question("Enter mode of the operation:"))
End Function

' This subroutine is called to run the selected macro mode.
'
' It will call the appropriate subroutine based on the mode
' selected by the user.
Sub RunMacroMode(ByVal Mode As Integer)
	Select Case Mode
		Case ZeroCoordMode
			Call ZeroZCoordinate()
		Case ToolCompMode
			Call ToolLengthCompensation()
		Case Else
			Call ExitWithError(MsgTypeDialog, "Invalid mode selected")
	End Select
End Sub

' Sets the Z-axis to zero by probing the touch plate.
'
' It will probe the Z-axis of the current tool and save
' Z-axis position to local coordinate system. (G54-G59)
'
' Program mode = 0 (ZeroCoordMode)
Sub ZeroZCoordinate()
	' Propose the user to enter the offset value for Z-Axis
	' which will be added to the probe position
	Dim Offset As Double
	Offset = Question("Enter the offset value for Z-Axis (" & MacroUnitsStr & "):")

	' Propose the user to send the machine to home position
	' If the user presses OK, it will automatically send the 
	' machine to home position, otherwise the machine will
	' be sent to only safe Z position.
	Dim ReturnMsg As Boolean
	ReturnMsg = ProposeSendHome()

	' Probe the Z-axis 
	Dim ProbePos As Double
	ProbePos = StartProbing() + PlateOffset + Offset

	Dim ReturnMsgSet As Boolean
	ReturnMsgSet = MachMSG("Z-axis position: " & ProbePos & MacroUnitsStr & CrLf & CrLf & _
		"Press OK to continue or Cancel to deny the offset.", _
		"Auto Tool Zero", MachMsgTypeOKCancel)

	' Set the Z-axis offset in the current fixture
	Call SetOEMDRO(FixtureOffsetZDRO, ProbePos)

	' Send the machine to home or safe Z
	If (ReturnMsg) Then
		Call MachMSG("Sends the machine to home position", "Auto Tool Zero", MachMsgTypeOK)
		Call SendHome()
	Else 
		Call MachMSG("Sends the machine to safe Z position", "Auto Tool Zero", MachMsgTypeOK)
		Call SendSafeZ(ZUpperBound)
	End If
End Sub

' Sets the tool length compensation by probing the touch plate
' with two different tools.
'
' It will probe the Z-axis of the first tool and save the value,
' after that it will display the dialog message and wait for
' the user to change the tool and press OK. By then it will
' probe the Z-axis of the new tool and calculate the difference
' between the two tool lengths. The result will be saved in the
' tool length compensation table for the second tool.
'
' Program mode = 1 (ToolCompMode)
Sub ToolLengthCompensation()
	' Cancel tool length compensation
	Call Code("G49")

	Dim FirstTool, SecondTool As Integer
	FirstTool = GetCurrentTool()

	' Ask user for the first tool number if it is not set
	If (FirstTool = 0) Then
		' Ask user for the tool number
		FirstTool = CInt(Question("Enter the first tool number (1-255):"))

		' Check if the tool number is valid
		If (FirstTool < 1 Or FirstTool > 255) Then
			Call ExitWithError(MsgTypeDialog, "Invalid tool number")
		End If

		' Select the first tool
		Call SetCurrentTool(FirstTool)
	End If

	' Ask user for the second tool number
	SecondTool = CInt(Question("Enter the second tool number (1-255):"))

	' Check if the tool number is valid
	If (SecondTool < 1 Or SecondTool > 255) Then
		Call ExitWithError(MsgTypeDialog, "Invalid tool number")
	End If

	' Propose the user to send the machine to home position
	' If the user presses OK, it will automatically send the 
	' machine to home position, otherwise the machine will
	' be sent to only safe Z position.
	Dim ReturnMsg As Boolean
	ReturnMsg = ProposeSendHome()

	Dim FirstToolPos, SecondToolPos As Double

	' Probe the Z-axis of the first tool
	FirstToolPos = StartProbing()
	Call Debug(MsgTypeDialog, "First tool position: " & FirstToolPos & MacroUnitsStr)
	
	' Send the machine to home or safe Z
	If (ReturnMsg) Then
		Call MachMSG("Sends the machine to home position", "Auto Tool Zero", MachMsgTypeOK)
		Call SendHome()
	Else 
		Call MachMSG("Sends the machine to safe Z position", "Auto Tool Zero", MachMsgTypeOK)
		Call SendSafeZ(ZUpperBound)
	End If

	' Propose the user to change the tool
	Call ProposeToolChange()

	' Set the second tool as the current tool
	Call SetCurrentTool(SecondTool)

	' Probe the Z-axis of the second tool
	SecondToolPos = StartProbing()
	Call Debug(MsgTypeDialog, "Second tool position: " & SecondToolPos & MacroUnitsStr)

	' Calculate tool compensation with the difference between
	' the two tool lengths
	Dim ToolComp As Double
	ToolComp = SecondToolPos - FirstToolPos

	' Ask user for a confirmation to set the tool length compensation
	Dim ReturnMsgComp As Boolean
	ReturnMsgComp = MachMSG("Tool length compensation: " & ToolComp & MacroUnitsStr & CrLf & CrLf & _
		"Press OK to continue or Cancel to deny the compensation.", _
		"Auto Tool Zero", MachMsgTypeOKCancel)

	If (ReturnMsgComp = MachMsgReturnOK) Then
		' Set the tool length compensation for the second tool
		' if the user confirms the compensation
		Call SetToolParam(SecondTool, ToolZoffsetParam, ToolComp)
		Call Code("G43")                                         
	Else
		' Cancel tool length compensation and switch back to
		' the first tool if the user denies the compensation
		Call Message("Tool length compensation canceled")
		Call SetCurrentTool(FirstTool)
	End If

	' Send the machine to home or safe Z
	If (ReturnMsg) Then
		Call MachMSG("Sends the machine to home position", "Auto Tool Zero", MachMsgTypeOK)
		Call SendHome()
	Else 
		Call MachMSG("Sends the machine to safe Z position", "Auto Tool Zero", MachMsgTypeOK)
		Call SendSafeZ(ZUpperBound)
	End If
	
	' Propose the user to return to the saved position
	' Call ReturnToSavedPos()
End Sub

' --------------------------------------------- '
'          Machine-related subroutines          '
' --------------------------------------------- '

' Returns the current move mode (G00/G01)
'
' It will return 0 for rapid move (G00)
' and 1 for linear move (G01)
Function GetMoveMode() As Integer
	GetMoveMode = GetOEMDRO(MoveModeDRO)
End Function

' Sets the move mode (G00/G01)
Sub SetMoveMode(ByVal MoveMode As Integer)
	Select Case MoveMode
		Case MoveModeRapid To MoveModeLinear
			Call Code("G" & MoveMode)
		Case Else
			Call Message("Invalid move mode (" & MoveMode & ") Setting to G01")
			Call Code("G01")
	End Select
End Sub

' Returns the current machine units (G20/G21)
'
' It will return 0 for millimeters (G21)
' and 1 for inches (G20)
Function GetUnits() As Integer
	GetUnits = GetParam("Units")
End Function

' Sets the machine units (in/mm) (G20/G21)
Sub SetUnits(ByVal Units As Integer)
	Select Case Units
		Case UnitsMM
			Call Code("G21")
		Case UnitsIn
			Call Code("G20")
		Case Else
			Call Message("Invalid units (" & Units & ") Setting to G21")
			Call Code("G21")
	End Select
End Sub

' Returns the current coordinate mode (G90/G91)
'
' It will return 0 for absolute coordinates (G90)
' and 1 for incremental coordinates (G91)
Function GetCoordMode() As Integer
	If (GetOEMLed(CoordAbsLED) = True) Then
		GetCoordMode = CoordModeAbsolute
	ElseIf (GetOEMLed(CoordIncLED) = True) Then
		GetCoordMode = CoordModeIncremental
	End If
End Function

' Sets the coordinate mode (G90/G91)
Sub SetCoordMode(ByVal CoordMode As Integer)
	Select Case CoordMode
		Case CoordModeAbsolute To CoordModeIncremental
			Call Code("G9" & CoordMode)
		Case Else
			Call Message("Invalid coordinate mode (" & CoordMode & ") Setting to G90")
			Call Code("G90")
	End Select
End Sub

' Returns whether the probe is wired or not
'
' It will return True if the probe is wired
' and False if the probe is not wired
Function IsProbeWired() As Boolean
	IsProbeWired = GetOEMLed(ProbeLED)
End Function

' Proposes the user to change the tool
'
' It will display a message box asking the user to change the tool.
' If the user presses Yes, it will ask for confirmation.
' If the user confirms, the function returns True.
' If the user presses No at any point, the question will repeat.
' If the user presses Cancel at any point, the macro will exit.
Function ProposeToolChange() As Boolean
	Dim ReturnMsg, ConfirmMsg As Integer
	Dim DecisionMade As Boolean

	' Propose the user to change the tool
	' and wait for the user to confirm or cancel
	Do While Not DecisionMade
		ReturnMsg = MachMSG("Change the tool and press Yes to continue.", _
			"Auto Tool Zero", MachMsgTypeYesNoCancel)

		Select Case ReturnMsg
			Case MachMsgReturnCancel
				Call ExitMacro()
			Case MachMsgReturnNo
				' Repeat the question
			Case MachMsgReturnYes
				ConfirmMsg = MachMSG("Are you sure you want to continue?", _
					"Auto Tool Zero", MachMsgTypeYesNoCancel)

				Select Case ConfirmMsg
					Case MachMsgReturnCancel
						Call ExitMacro()
					Case MachMsgReturnNo
						' Repeat the whole process
					Case MachMsgReturnYes
						ProposeToolChange = True
						DecisionMade = True
				End Select
		End Select
	Loop
End Function

' Proposes the user to send the machine to home position
'
' It will display a message box with the message and
' wait for the user to press Yes or No. If the user 
' presses Yes, it will send the machine to home position
' and return True. If the user presses No, it will
' send the machine to safe Z position and return False.
Function ProposeSendHome() As Boolean
	Dim ReturnMsg, ConfirmMsg As Integer
	Dim DecisionMade As Boolean

	' Propose the user to send the machine to home position
	' and wait for the user to make a decision
	Do While Not DecisionMade
		ReturnMsg = MachMSG("Send the machine to home position and safe Z?" & CrLf & _
			"If you press No, the probe will be started from the current XY position and safe Z.", _
			"Auto Tool Zero", MachMsgTypeYesNo)

		If (ReturnMsg = MachMsgReturnYes) Then
			Call SendHome()

			ProposeSendHome = True
			DecisionMade = True
		Else
			ConfirmMsg = MachMSG("Are you sure you want to continue from the current position?", _
				"Auto Tool Zero", MachMsgTypeYesNo)

			If (ConfirmMsg = MachMsgReturnYes) Then
				Call SendSafeZ(ZUpperBound)

				ProposeSendHome = False
				DecisionMade = True
			End If
		End If
	Loop
End Function

' Sends the machine to the home position and safe Z
Sub SendHome()
	' Sleep for 1 seconds
	Call Sleep(1000)

	' Set the params to macro parameters
	Call SetUnits(MacroUnits)
	Call SetCoordMode(CoordModeAbsolute)
	While (IsMoving())
		Call Sleep(100) ' Sleep, so other threads can run while we’re waiting
	Wend

	' Set the params to macro parameters
	Call Debug(MsgTypeStatus, "Moving to the safe position for Z-axis in machine coordinates (" & ZUpperBound & ")")

	' Move to the safe position for Z-axis
	Call Code("G53 G0 Z" & ZUpperBound)
	While (IsMoving())
		Call Sleep(100) ' Sleep, so other threads can run while we’re waiting
	Wend

	Call Debug(MsgTypeStatus, "Moving to the machine home for X and Y axes")

	' Move to the home for x and y axes
	Call Code("G91 G28 X0 Y0")
	While (IsMoving())
		Call Sleep(100) ' Sleep, so other threads can run while we’re waiting
	Wend

	Call Debug(MsgTypeStatus, "Moved to the machine home for X and Y axes and safe Z position")

	Call SetCoordMode(CoordModeAbsolute)
End Sub

' Returns the machine to the saved position
Sub ReturnToSavedPos()
	' Suggest the user to return to the saved position
	Call CancellableMsg("Want return to saved position?", "Auto Tool Zero")

	' Set the params to macro parameters
	Call SetUnits(CurrentUnits)
	Call SetCoordMode(CoordModeAbsolute)
	While (IsMoving())
		Call Sleep(100) ' Sleep, so other threads can run while we’re waiting
	Wend

	' Move to the saved position for Z-axis
	Call Debug(MsgTypeStatus, "Returning to the saved position for Z-axis in machine coordinates")
	Call Code("G53 G0 Z" & CurrentZ)
	While (IsMoving())
		Call Sleep(100) ' Sleep, so other threads can run while we’re waiting
	Wend

	' Move to the saved position for X and Y axes
	Call Debug(MsgTypeStatus, "Returning to the saved position for X and Y axes in machine coordinates")
	Call Code("G53 G0 X" & CurrentX & " Y" & CurrentY)
	While (IsMoving())
		Call Sleep(100) ' Sleep, so other threads can run while we’re waiting
	Wend
End Sub

' Probes the Z-axis of the machine and returns the
' position of the probe in machine coordinates.
Function StartProbing() As Double
	Call Sleep(1000)
	
	' Set the params to macro parameters
	Call SetMoveMode(MoveModeLinear)
	Call SetUnits(MacroUnits)
	Call SetCoordMode(CoordModeAbsolute)
	While (IsMoving())
		Call Sleep(100) ' Sleep, so other threads can run while we’re waiting
	Wend

	' Start fast probing
	Call Debug(MsgTypeStatus, "Fast probing")
	Call Code("G31 Z" & ZLowerBound & " F" & ProbeFeed)
	While (IsMoving())
		Call Sleep(100) ' Sleep, so other threads can run while we’re waiting
	Wend

	Call SendSafeZ(GetABSPosition(ZAxis))

	' Start finish probing
	Call Debug(MsgTypeStatus, "Finishing probing")
	Call Code("G31 Z" & ZLowerBound & " F" & FinishProbeFeed)
	While (IsMoving())
		Call Sleep(100) ' Sleep, so other threads can run while we’re waiting
	Wend

	Dim ProbePos As Double
	ProbePos = GetVar(ProbeOffsetZVar)

	Call Debug(MsgTypeStatus, "Raw probe position: " & ProbePos & MacroUnitsStr)
	Call SendSafeZ(GetABSPosition(ZAxis))

	' Return the probe position in machine coordinates
	StartProbing = ProbePos
End Function

' Sends the machine to safe z position from certain position.
Sub SendSafeZ(ByVal ZPos As Double)
	' Sleep for 1 seconds
	Call Sleep(1000)

	Dim SafePos As Double
	SafePos = ZPos + SafeMargin

	Call Code("G53 G0 Z" & TernaryIf(SafePos > ZUpperBound, ZUpperBound, SafePos))
	While (IsMoving())
		Call Sleep(100) ' Sleep, so other threads can run while we’re waiting
	Wend
End Sub

' --------------------------------------------- '
'             Macro-related section             '
' --------------------------------------------- '

' This subroutine is used for debugging purposes.
'
' It will display the message with "DEBUG:" prefix
' in the status bar of Mach3 or in a dialog box.
Sub Debug(ByVal MsgType As Integer, ByVal MsgText As String)
	If (DebugMode) Then
		Select Case MsgType
			Case MsgTypeStatus
				Call Message("DEBUG: " & MsgText)
			Case MsgTypeDialog
				Call CancellableMsg("DEBUG: " & MsgText, "Debug Message")
			Case Else
				Call ExitWithError(MsgTypeDialog, "Invalid message type")
		End Select
	End If
End Sub

' This subroutine is used to display a message box with
' an OK and Cancel button.
'
' It will display the message and wait for the user to
' press OK or Cancel. If the user presses Cancel, it will
' exit the macro.
Sub CancellableMsg(ByVal Text As String, ByVal Title As String)
	Dim ReturnMsg As Integer
	ReturnMsg = MachMSG(Text & CrLf & CrLf & _
		"Press OK to continue or Cancel to exit the macro.", _
		Title, MachMsgTypeOKCancel)

	' If the user presses Cancel, it will exit the macro
	' and restore the original parameters
	If (ReturnMsg = MachMsgReturnCancel) Then
		Call ExitMacro()
	End If
End Sub

' This subroutine is called when the macro encounters an error.
'
' It will display the error message, restore the original values
' and end the macro.
Sub ExitWithError(ByVal MsgType As Integer, ByVal MsgText As String)
	Dim Msg As String
	Msg = "ERROR: " & MsgText
	
	Select Case MsgType
		Case MsgTypeStatus
			Call Message(Msg)
		Case MsgTypeDialog
			Call MachMSG(Msg & CrLf & CrLf & _
				"Press OK to exit the macro.", _
				"Critical Error", MachMsgTypeOK)
		Case Else
			Call ExitWithError(MsgTypeDialog, "Invalid message type")
	End Select

	Call ExitMacro()
End Sub

' This subroutine is called when the macro is finished.
'
' It will restore the original values and move to the home position.
Sub ExitMacro()
	' Restore original values
	Call SetMoveMode(CurrentMoveMode)   ' Restore original move mode
	Call SetUnits(CurrentUnits)         ' Restore original units
	Call SetCoordMode(CurrentCoordMode) ' Restore original coordinate mode
	Call SetFeedRate(CurrentFeed / 60)  ' Restore original feedrate

	While (IsMoving())
		Call Sleep(100) ' Sleep, so other threads can run while we’re waiting
	Wend

	Call Debug(MsgTypeStatus, "Exited macro and restored original values")
	End
End Sub

' This is a simple implementation of the ternary operator.
' 
' It takes a condition and two values, and returns the 
' first value if the condition is true, and the second 
' value if the condition is false.
Function TernaryIf(ByVal Condition As Boolean, ByVal TrueValue As Variant, ByVal FalseValue As Variant) As Variant
	If (Condition) Then
		TernaryIf = TrueValue
	Else
		TernaryIf = FalseValue
	End If
End Function
