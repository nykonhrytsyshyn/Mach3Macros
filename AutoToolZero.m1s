' -------------------------------------------------------------------
' Settings for Auto Tool Zero Macro
' -------------------------------------------------------------------

Const PlateThickness = 2.0    ' Thickness of the touch plate (mm)
Const ProbeFeed = 100.0       ' Feedrate to use for probing (unit/min)
Const MoveFeed = 30.0         ' Feedrate to use for movements (unit/min)
Const RetractClearance = 10.0 ' Distance above touch plate to retract (mm)

Const DebugMode = True        ' Set to True to enable debug messages

' -------------------------------------------------------------------
' Constant numbers
' -------------------------------------------------------------------

Const ProbeSignal = 22 ' Input number for probe signal
Const ProbeLED = 825   ' LED number for probe (Diditize Input)

' -------------------------------------------------------------------

Dim CrLf as String
CrLf = Chr$(13) & Chr$(10)

Const MsgTypeStatus = 0
Const MsgTypeDialog = 1

' -------------------------------------------------------------------
' Saved current parameters
' -------------------------------------------------------------------

Dim CurrentFeed as Double
Dim CurrentCoordMode as Integer

CurrentFeed = FeedRate       ' Save current feedrate (unit/min)
CurrentCoordMode = GetIJMode ' Save current coordinate mode (G90/G91)

' -------------------------------------------------------------------

Call Main()

' Main subroutine.
' This is where the main logic of the macro is executed.
Sub Main()
	' Debug saved parameters
	Call Debug(MsgTypeDialog, "Current Savings:" & CrLf & _
		"- Feedrate: " & CurrentFeed & " mm/min" & CrLf & _
		"- Coordinate Mode: " & CurrentCoordMode)

	' Check for probe wiring
	If IsSuchSignal(ProbeSignal) = 0 Then 
		Call ExitWithError(MsgTypeDialog, "No Touch probe wired")
	End If 

	' Check for probe grounding
	If GetOEMLed(ProbeLED) <> 0 Then
		Call ExitWithError(MsgTypeDialog, "Touch Plate is already grounded")
	End If

	Call ExitProgram()
End Sub

' This subroutine is used for debugging purposes.
' It will display the message in the status bar.
Sub Debug(ByVal MsgType As Integer, ByVal MsgText As String)
	If DebugMode Then
		Dim Msg as String
		Msg = "DEBUG: " & MsgText

		If (MsgType = MsgTypeStatus) Then 
			Message(Msg)
		ElseIf (MsgType = MsgTypeDialog) Then 
			MachMSG(Msg, "Debug Message", 0)
		End If
	End If
End Sub

' This is called when a critical error occurs.
' It will display the error message, restore the original values
' and end the macro.
Sub ExitWithError(ByVal MsgType As Integer, ByVal MsgText As String)
	Dim Msg as String
	Msg = "ERROR: " & MsgText

	If (MsgType = MsgTypeStatus) Then 
		Message(Msg)
	ElseIf (MsgType = MsgTypeDialog) Then 
		MachMSG(Msg, "Critical Error", 0)
	End If

	Call ExitProgram()
End Sub

' This subroutine is called when the macro is finished.
' It will restore the original values and move to the home position.
Sub ExitProgram()
	SetOEMDRO(FeedrateDRO, CurrentFeed) ' Restore original feedrate
	SetIJMode(CurrentCoordMode)         ' Restore original coordinate mode

	End
End Sub
